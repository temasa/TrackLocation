<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only diagnostic screen recorder (ADR-021). Not part of release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>

        <provider
            android:name=".debug.DiagnosticsInitProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false" />

        <activity
            android:name=".debug.DiagnosticConsentActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".debug.DiagnosticRecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
